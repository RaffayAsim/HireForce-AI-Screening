{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/auth/login",
      "destination": "/api/auth/session?action=login"
    },
    {
      "source": "/api/auth/signup",
      "destination": "/api/auth/session?action=signup"
    },
    {
      "source": "/api/test-smtp",
      "destination": "/api/emails/send?action=test-smtp"
    },
    {
      "source": "/api/emails",
      "destination": "/api/emails/messages"
    },
    {
      "source": "/api/send-email",
      "destination": "/api/emails/send"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}